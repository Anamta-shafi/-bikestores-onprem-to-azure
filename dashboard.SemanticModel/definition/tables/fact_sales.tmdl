table fact_sales
	lineageTag: 8ae5566b-6270-47c3-ac3a-345243593150

	measure 'Total Revenue' = SUM ( fact_sales[revenue] )
		formatString: $#,0
		lineageTag: c769702e-7458-4967-8926-2086df25dde3

	measure 'Total Orders' = DISTINCTCOUNT ( fact_sales[order_id] )
		formatString: #,0
		lineageTag: 26a7a703-7dd0-449b-ae4f-42242c86bfde

	measure 'Units Sold' = SUM ( fact_sales[quantity] )
		formatString: #,0
		lineageTag: 7062fe8b-f000-43a6-ae3b-8b338a76e23b

	measure 'Avg Order Value' = DIVIDE ( [Total Revenue], [Total Orders] )
		formatString: $#,0.00
		lineageTag: 35bb2806-7832-40ee-bdc6-972f4dae8866

	measure 'Cumulative Revenue' =
			CALCULATE (
			    [Total Revenue],
			    FILTER (
			        ALLSELECTED ( 'Calendar'[Date] ),
			        'Calendar'[Date] <= MAX ( 'Calendar'[Date] )
			    )
			)
		formatString: $#,0
		lineageTag: fcd4f666-0641-4285-8cd3-64d8155f3106

