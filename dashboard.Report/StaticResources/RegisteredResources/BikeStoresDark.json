        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E6EEF8"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E6EEF8"
