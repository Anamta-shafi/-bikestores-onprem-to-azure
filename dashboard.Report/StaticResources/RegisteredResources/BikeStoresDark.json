{
  "name": "BikeStoresDark",
  "dataColors": [
    "#1E88E5",
    "#64B5F6",
    "#2DD4BF",
    "#FFB74D",
    "#E040C8",
    "#B388FF"
  ],
  "background": "#06172E",
  "foreground": "#B8C7DC",
  "tableAccent": "#1E88E5",
  "good": "#2DD4BF",
  "neutral": "#FFB74D",
  "bad": "#E040C8",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#FFFFFF"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#FFFFFF"
